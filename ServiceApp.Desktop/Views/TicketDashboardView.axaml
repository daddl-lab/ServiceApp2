<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ServiceApp.Desktop.ViewModels"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             x:Class="ServiceApp.Desktop.Views.TicketDashboardView"
             x:DataType="vm:TicketDashboardViewModel">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Zeitraum- und Typ-Filter -->
        <Border Grid.Row="0" Padding="16 12" Background="{DynamicResource SystemAltHighColor}">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Tag" Command="{Binding SelectTodayCommand}" />
                    <Button Content="Woche" Command="{Binding SelectThisWeekCommand}" />
                    <Button Content="Monat" Command="{Binding SelectThisMonthCommand}" />
                    <Button Content="Jahr" Command="{Binding SelectThisYearCommand}" />
                    <TextBlock Text="Benutzerdefiniert:" VerticalAlignment="Center" Margin="16 0 0 0" />
                    <CalendarDatePicker SelectedDate="{Binding CustomRangeStart}" Width="140" />
                    <TextBlock Text="bis" VerticalAlignment="Center" />
                    <CalendarDatePicker SelectedDate="{Binding CustomRangeEnd}" Width="140" />
                    <Button Content="Anwenden" Command="{Binding ApplyCustomRangeCommand}" />
                    <Button Content="Aktualisieren" Command="{Binding ReloadCommand}" Margin="16 0 0 0" />
                    <TextBlock Text="Lädt…" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" Margin="8 0 0 0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Typ:" VerticalAlignment="Center" />
                    <Button Content="{Binding TypeFilterSummary}">
                        <Button.Flyout>
                            <Flyout>
                                <ScrollViewer MaxHeight="320">
                                    <ItemsControl ItemsSource="{Binding TypeOptions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TypeFilterOption">
                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Fehler-/Hinweisbanner -->
        <Border Grid.Row="1" Padding="16 8" Background="#33C62828" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource MissedBrush}" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer Grid.Row="2" Padding="16">
            <StackPanel Spacing="16">

                <Border Classes="card" MaxWidth="260" HorizontalAlignment="Left">
                    <StackPanel>
                        <TextBlock Text="Gesamtanzahl Tickets" Classes="metricLabel" />
                        <TextBlock Text="{Binding TotalTickets}" Classes="metricValue" Foreground="{StaticResource TotalBrush}" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Text="Zeitlicher Verlauf (Anlagedatum)" Classes="sectionTitle" />
                        <lvc:CartesianChart Series="{Binding TimeSeries}" XAxes="{Binding TimeSeriesXAxes}" Height="280" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Text="Fehlerursachen" Classes="sectionTitle" />
                        <!-- Legende rechts statt unten: bei bis zu neun (teils zweizeiligen)
                             Einträgen würde eine untenliegende Legende in einem Diagramm
                             fester Höhe den für den Kreis selbst verfügbaren Platz auf
                             nahezu Null verdrängen. -->
                        <lvc:PieChart x:Name="CauseBreakdownPieChart" Series="{Binding CauseBreakdownSeries}" Height="420"
                                      InitialRotation="0" MaxAngle="360" LegendPosition="Right" />
                        <TextBlock Text="Klick auf ein Kuchenstück zeigt die zugehörigen Tickets als Tabelle." Classes="hint" Margin="0 4 0 0" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Drill-Down: Tabelle der Tickets einer angeklickten Fehlerursache, als
             Overlay über dem gesamten Dashboard eingeblendet. -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="#AA000000"
                IsVisible="{Binding IsDrillDownVisible}">
            <Border Classes="card" Margin="32" MaxWidth="1400" MaxHeight="700" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,*" MinWidth="900" Height="650">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0 0 0 8">
                        <TextBlock Grid.Column="0" Text="{Binding DrillDownTitle}" Classes="sectionTitle" />
                        <Button Grid.Column="1" Content="Schließen" Command="{Binding CloseDrillDownCommand}" />
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding DrillDownTickets}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Adresszeile" Binding="{Binding AddressLine}" Width="2*" />
                            <DataGridTextColumn Header="Typ" Binding="{Binding Type}" Width="*" />
                            <DataGridTextColumn Header="Fehlercode Ort" Binding="{Binding ErrorLocation}" Width="*" />
                            <DataGridTextColumn Header="Fehlercode Ursache" Binding="{Binding Cause}" Width="1.5*" />
                            <DataGridTextColumn Header="Fehlercode Behebung" Binding="{Binding ErrorFix}" Width="1.5*" />
                            <DataGridTextColumn Header="Interner Status" Binding="{Binding InternalStatus}" Width="*" />
                            <DataGridTextColumn Header="Verantwortlich" Binding="{Binding Responsible}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Border>
    </Grid>

</UserControl>
