<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Wiederverwendbare Karten-Optik für Dashboard-Kacheln (Kennzahlen, Diagramme). -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource SystemAltHighColor}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="BoxShadow" Value="0 1 4 0 #22000000" />
    </Style>

    <Style Selector="TextBlock.metricValue">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="TextBlock.metricLabel">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Opacity" Value="0.7" />
    </Style>

    <Style Selector="TextBlock.sectionTitle">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0 0 0 8" />
    </Style>

    <Style Selector="TextBlock.hint">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Opacity" Value="0.6" />
    </Style>

</Styles>
